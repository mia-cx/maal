{
	"name": "maal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=24.0.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen && pnpm i18n:compile && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "pnpm gen && pnpm i18n:compile && svelte-kit sync",
		"check": "pnpm gen && pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"perf:budget": "node scripts/check-build-budget.mjs",
		"gen": "wrangler types",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply maal-v1-local --local",
		"db:migrate:staging": "wrangler d1 migrations apply maal-v1-staging --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply maal-v1-production --remote --env production",
		"db:studio": "drizzle-kit studio",
		"validate": "pnpm lint && pnpm check && pnpm test:unit && pnpm build && pnpm perf:budget && pnpm test:e2e"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.4",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@workos-inc/node": "^10.7.0",
		"dexie": "^4.4.4",
		"drizzle-orm": "^0.45.2",
		"effect": "^3.21.4",
		"stripe": "^22.3.1",
		"uuidv7": "^1.2.1"
	}
}
