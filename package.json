{
	"name": "maal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=24.0.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm gen && pnpm i18n:compile && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "pnpm gen && pnpm i18n:compile && svelte-kit sync",
		"check": "pnpm gen && pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:d1-schema": "node scripts/test-d1-schema.mjs",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test:proof:auth-slots": "playwright test --config playwright.auth-slots.config.ts",
		"test:proof:auth-slots:api": "node scripts/prove-auth-slots-workos.mjs",
		"test:proof:auth-slots:hosted": "node scripts/prove-auth-slots-hosted.mjs",
		"proof:auth-slots:evidence": "node scripts/auth-slot-native-evidence.mjs",
		"test:proof:billing": "node scripts/prove-billing-services.mjs",
		"test:proof:product": "playwright test --config playwright.product-proof.config.ts --project=chromium",
		"test:proof:product:browsers": "playwright test --config playwright.product-proof.config.ts --grep @browser-smoke",
		"proof:prototype-ui": "node scripts/check-prototype-ui.mjs",
		"proof:staging": "node scripts/prove-staging-cutover.mjs",
		"perf:budget": "node scripts/check-build-budget.mjs",
		"gen": "wrangler types",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply maal-v1-local --local",
		"db:migrate:staging": "wrangler d1 migrations apply maal-v1-staging --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply maal-v1-production --remote --env production",
		"db:studio": "drizzle-kit studio",
		"validate": "pnpm lint && pnpm check && pnpm test:unit && pnpm build && pnpm perf:budget && pnpm test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/vitest-pool-workers": "^0.18.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/noto-sans": "^5.2.10",
		"@fontsource-variable/nunito-sans": "^5.2.7",
		"@fontsource/lexend": "^5.2.11",
		"@inlang/paraglide-js": "^2.18.2",
		"@lucide/svelte": "^0.577.0",
		"@modelcontextprotocol/client": "2.0.0",
		"@playwright/test": "^1.60.0",
		"@solar-icons/svelte": "^1.1.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^24",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"layerchart": "2.0.0-next.48",
		"miniflare": "4.20260708.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "3.0.0",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@workos-inc/node": "^10.7.0",
		"@zip.js/zip.js": "^2.8.55",
		"agents": "0.21.0",
		"dexie": "^4.4.4",
		"drizzle-orm": "^0.45.2",
		"effect": "^3.21.4",
		"stripe": "^22.3.1",
		"uuidv7": "^1.2.1",
		"zod": "^4.2.0"
	}
}
